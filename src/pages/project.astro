---
import BaseLayout from '@layouts/BaseLayout.astro';
import { resolvePath } from '../lib/paths';
---

<BaseLayout title="Project">
  <section class="max-w-3xl mx-auto px-6 pt-12 pb-16">
    <p class="font-mono text-sm text-orbit tracking-widest mb-4" data-reveal="1">
      MIT 16.S893 PROJECT
    </p>
    <h1 data-reveal="1">Project</h1>

    <p class="text-lg text-space-200 mt-6 max-w-2xl" data-reveal="2">
      AI agent to accelerate in-space assembly engineering research.
    </p>

    <p class="text-base text-space-400 mt-6 max-w-2xl" data-reveal="3">
      Project scope is still being defined. This page will be updated with real
      details once the direction is settled — see the <a href={resolvePath('/dev-log')}>dev log</a>
      for the current state of the work.
    </p>
  </section>
</BaseLayout>
