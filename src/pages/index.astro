---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArcReactor from '@components/ArcReactor.astro';
import { resolvePath } from '../lib/paths';
---

<BaseLayout title="Home">
  <section class="max-w-4xl mx-auto px-6 pt-16 pb-12">
    <div class="flex justify-center">
      <ArcReactor />
    </div>

    <p class="font-mono text-sm text-orbit tracking-widest mb-4 text-center" data-reveal="1">
      MIT 16.S893 · AI AGENTS FOR ENGINEERING RESEARCH
    </p>
    <h1 class="text-center" data-reveal="2">AI Agent for In-Space Assembly</h1>
    <p class="text-base text-space-300 mt-6 max-w-2xl mx-auto text-center" data-reveal="3">
      Lightweight computer vision for autonomous in-space robotic assembly — a compact,
      locally-deployable model for panel placement and docking on the ORLO* assembly robots.
    </p>

    <div class="mt-10 flex justify-center" data-reveal="4">
      <figure class="max-w-2xl">
        <img
          src={resolvePath('/images/assembly_3d.gif')}
          alt="Animated 3D plot of the ORLO* structure's changing orientation during robotic assembly"
          class="w-full h-auto border border-orbit/15 rounded-xl"
        />
        <figcaption class="text-xs text-space-400 italic mt-2 text-center">
          3D assembly animation: structure orientation over the course of robotic assembly.
        </figcaption>
      </figure>
    </div>

    <div class="flex flex-wrap gap-4 mt-10 justify-center" data-reveal="5">
      <a
        href={resolvePath('/project')}
        class="px-6 py-3 rounded-xl border border-space-600 text-space-200 font-medium no-underline hover:border-orbit/40 transition-all"
      >
        The project →
      </a>
      <a
        href={resolvePath('/about')}
        class="px-6 py-3 rounded-xl border border-space-600 text-space-200 font-medium no-underline hover:border-orbit/40 transition-all"
      >
        About the work
      </a>
      <a
        href={resolvePath('/dev-log')}
        class="px-6 py-3 rounded-xl border border-space-600 text-space-200 font-medium no-underline hover:border-orbit/40 transition-all"
      >
        Dev log
      </a>
    </div>
  </section>

</BaseLayout>
