---
import BaseLayout from '@layouts/BaseLayout.astro';

// Add new entries to the top of this list as the project progresses.
const entries = [
  {
    date: '2025-09-11',
    title: 'Repository and site scaffolded',
    body:
      'Created the class repo (michaelkuhl10) and stood up the Astro + Tailwind portfolio site, following the class convention. Next: fill in the project one-pager.',
  },
];
---

<BaseLayout title="Dev Log">
  <section class="max-w-3xl mx-auto px-6 pt-12 pb-16">
    <h1 data-reveal="1">Dev Log</h1>
    <p class="mt-6 max-w-2xl" data-reveal="2">
      A running record of what I tried, what worked, what failed, and what I
      learned. This is the part the class cares about most — the process, not
      just the result.
    </p>

    <div class="mt-12 space-y-10">
      {entries.map((entry, i) => (
        <article
          class="relative border-l-2 border-orbit/30 pl-6"
          data-reveal={String(Math.min(i + 1, 5))}
        >
          <span class="absolute -left-[7px] top-1.5 w-3 h-3 bg-orbit shadow-orbit-sm"></span>
          <time class="font-mono text-xs text-space-400 tracking-widest">
            {entry.date}
          </time>
          <h3 class="mt-1 mb-2 text-orbit-light">{entry.title}</h3>
          <p class="text-base text-space-300 m-0">{entry.body}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
