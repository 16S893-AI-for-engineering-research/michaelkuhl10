---
import BaseLayout from '@layouts/BaseLayout.astro';
import { resolvePath } from '@lib/paths';
import { entries } from '@data/dev-log';
import { Content as DebateEssay } from '../essays/ai-research-debate-paper.md';

// Group entries by month for the side index.
const months = [...new Set(entries.map((e) => e.date.slice(0, 7)))];
const monthLabel = (ym: string) =>
  new Date(ym + '-15').toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const dayLabel = (d: string) =>
  new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
---

<BaseLayout title="Dev Log" description="Session-by-session record of the in-space assembly project.">
  <section class="container-page pt-14 pb-6">
    <p class="eyebrow">Dev log</p>
    <h1 class="mt-2">Session by session</h1>
    <p class="mt-4 max-w-prose text-lg text-slate-600">
      A record of each work session, newest first. The left side lists what was built or changed.
      The right side is my own notes on the same session. {entries.length} entries.
    </p>
  </section>

  <div class="container-page grid gap-10 lg:grid-cols-[10rem_1fr]">
    <aside class="hidden lg:block">
      <nav class="sticky top-24 space-y-1 text-sm">
        {months.map((m) => (
          <a href={`#${m}`} class="block rounded px-2 py-1 text-slate-500 no-underline hover:bg-slate-50 hover:text-arc-700">
            {monthLabel(m)}
          </a>
        ))}
      </nav>
    </aside>

    <div>
      {months.map((m) => (
        <section id={m} class="scroll-mt-24">
          <h2 class="mb-6 mt-4 border-b border-slate-200 pb-2 text-base font-semibold uppercase tracking-wider text-slate-400">
            {monthLabel(m)}
          </h2>
          <div class="space-y-10">
            {entries.filter((e) => e.date.startsWith(m)).map((entry) => (
              <article class="relative">
                <div class="flex items-baseline gap-3">
                  <time datetime={entry.date} class="shrink-0 font-mono text-xs font-medium text-arc-600">
                    {dayLabel(entry.date)}
                  </time>
                  <h3 class="m-0">{entry.title}</h3>
                </div>

                <div class="card mt-4 grid overflow-hidden md:grid-cols-2">
                  <div class="p-5 md:border-r border-b md:border-b-0 border-slate-200">
                    <p class="eyebrow mb-3 text-slate-500">Session summary</p>
                    <ul class="m-0 list-disc space-y-1.5 pl-5 text-[15px] leading-6 marker:text-arc-400">
                      {entry.aiSummary.map((b) => <li>{b}</li>)}
                    </ul>
                    {entry.attachment && (
                      <a href={resolvePath(entry.attachment.href)} target="_blank" rel="noopener" class="btn-secondary mt-4">
                        {entry.attachment.label} ↗
                      </a>
                    )}
                  </div>
                  <div class="bg-arc-50/50 p-5">
                    <p class="eyebrow mb-3">My notes</p>
                    <p class="m-0 whitespace-pre-line text-[15px] leading-6 text-slate-700">{entry.personalNotes}</p>
                  </div>
                </div>

                {entry.image && (
                  <figure class="card mt-4 overflow-hidden">
                    <img src={resolvePath(entry.image.src)} alt={entry.image.alt} loading="lazy" class="block w-full h-auto" />
                    {entry.image.caption && (
                      <figcaption class="border-t border-slate-200 px-5 py-3 text-sm text-slate-500">{entry.image.caption}</figcaption>
                    )}
                  </figure>
                )}

                {entry.essay === 'debate' && (
                  <details class="card mt-4 overflow-hidden">
                    <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-arc-700">
                      Read the full essay: To Accelerate or to Restrain?
                    </summary>
                    <div class="prose-body border-t border-slate-200 px-5 pb-6 pt-2">
                      <DebateEssay />
                    </div>
                  </details>
                )}
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
