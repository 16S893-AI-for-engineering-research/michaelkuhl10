---
import BaseLayout from '@layouts/BaseLayout.astro';
import crypto from 'node:crypto';

// ---------------------------------------------------------------------------
// Schedule page
//
// The schedule content below is rendered to an HTML string at BUILD time,
// encrypted with AES-256-GCM using a key derived from the passphrase, and only
// the ciphertext is shipped to the browser. The browser decrypts it in-page
// after the correct passphrase is entered. Because this is a static site
// (GitHub Pages) there is no server to check a password against, so real
// encryption is used instead of merely hiding the markup with JS.
//
// Passphrase: "Schedule"
// ---------------------------------------------------------------------------
const PASSPHRASE = 'Schedule';
const PBKDF2_ITERATIONS = 150_000;

// Course calendar facts come from the 16.S893 syllabus:
//   Tue/Thu 9:30-11:00, room 33-218. 23 sessions.
//   No class Tue 13 Oct (MIT Monday schedule) or Thu 26 Nov (Thanksgiving).
// Block A session dates/topics are published. Block B/C dates are projected
// onto the Tue/Thu pattern and flagged as projected where the syllabus says
// "exact dates will be posted".

const deadlines = [
  { date: 'Tue 15 Sep, 9 am', what: 'Assignment 1 — portfolio site live, pull request on the class repo', status: 'done' },
  { date: 'Tue 22 Sep', what: 'Project one-pager, advisor sign-off by reply-all email', status: 'due' },
  { date: 'Thu 24 Sep', what: 'Lightning talk on proposal, 3 minutes', status: 'due' },
  { date: '~Tue 20 Oct', what: 'Assignment 2 (projected — released as we go, one every three weeks)', status: 'projected' },
  { date: '~Tue 10 Nov', what: 'Assignment 3 (projected)', status: 'projected' },
  { date: '~Tue 1 Dec', what: 'Assignment 4 (projected)', status: 'projected' },
  { date: 'Fri 4 Dec, 5 pm', what: 'Final portfolio freeze — tagged commit or stable URL', status: 'upcoming' },
  { date: 'Week of 7 Dec', what: 'Reflective one-on-one discussion, scheduled individually', status: 'upcoming' },
];

const grading = [
  { c: 'Proposal + advisor sign-off + computer fluency', w: 'Required' },
  { c: 'Four short practical, open-ended assignments', w: '30%' },
  { c: 'GitHub portfolio + AI-use dev log', w: '30%' },
  { c: 'Final presentation', w: '15%' },
  { c: 'Final 1-1 reflective discussion', w: '15%' },
  { c: 'Clinic & peer-feedback engagement', w: '10%' },
];

const weeks = [
  {
    n: 1,
    range: 'Mon 7 – Sun 13 Sep',
    block: 'Block A',
    status: 'done',
    sessions: [
      { no: 1, date: 'Thu 10 Sep', topic: 'Introduction to the course, diagnostic poll, setup' },
    ],
    course: [
      { t: 'Attend session 1; complete the ungraded diagnostic poll.', done: true },
      { t: 'Bootcamp office hours (Thu 10, Fri 11, Mon 14 Sep) — git, shell, pi and Parley working.', done: true },
      { t: 'Work through Missing Semester lectures 1–4 (shell, scripting, data wrangling, git).', done: true },
      { t: 'Flag any IP / export-control constraints on ORLO* material in week 1.', done: true },
    ],
    research: [
      { t: 'Pick the live research thread: ORLO* (Orbital Locker Surface Tile Assembly Robot) two-robot planar assembly.', done: true },
      { t: 'Write down what is actually known about R1 (±Y, stores panels) and R2 (+X place, −X return to dock).', done: true },
      { t: 'List the gaps honestly: how space complicates control, and no ROS experience yet.', done: true },
    ],
  },
  {
    n: 2,
    range: 'Mon 14 – Sun 20 Sep',
    block: 'Block A',
    status: 'done',
    sessions: [
      { no: 2, date: 'Tue 15 Sep', topic: 'Mental models for LLMs, agents and harnesses — every portfolio site reviewed' },
      { no: 3, date: 'Thu 17 Sep', topic: 'The model as a service, the harness by hand, and skills' },
    ],
    course: [
      { t: 'Assignment 1 due Tue 15 Sep 9 am — portfolio site live, PR on the class repo.', done: true, due: true },
