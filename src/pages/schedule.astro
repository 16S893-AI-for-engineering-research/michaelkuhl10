    block: 'Block B',
    status: 'upcoming',
    sessions: [
      { no: 15, date: 'Tue 3 Nov', topic: 'Project work (date projected)', projected: true },
      { no: 16, date: 'Thu 5 Nov', topic: 'Project work (date projected)', projected: true },
    ],
