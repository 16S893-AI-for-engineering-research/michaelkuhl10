  {
    n: 10,
    range: 'Mon 9 – Sun 15 Nov',
    block: 'Block B ends',
    status: 'upcoming',
    sessions: [
      { no: 17, date: 'Tue 10 Nov', topic: 'Project work (date projected)', projected: true },
      { no: 18, date: 'Thu 12 Nov', topic: 'Project work — end of Block B (date projected)', projected: true },
    ],
    course: [
      { t: 'Assignment 3 due ~Tue 10 Nov (projected — confirm in class).', due: true },
      { t: 'Ask for a final-presentation slot and put the date in the calendar.' },
      { t: 'Dev log: the agent failure modes catalogue, with the fix for each.' },
    ],
    research: [
      { t: 'Docking campaign: 100+ trials per condition across the lighting / occlusion / initial-offset grid.' },
      { t: 'Report success rate with confidence intervals, not a single hero run.' },
      { t: 'Threshold study on the confidence gate: success rate vs how often it stops unnecessarily.' },
