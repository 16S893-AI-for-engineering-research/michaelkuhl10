  {
    n: 12,
    range: 'Mon 23 – Sun 29 Nov',
    block: 'Block C',
    status: 'upcoming',
    sessions: [
      { no: 21, date: 'Tue 24 Nov', topic: 'Final presentations (slot TBA)', projected: true },
      { no: null, date: 'Thu 26 Nov', topic: 'No class — Thanksgiving', off: true },
    ],
    course: [
      { t: 'Present or review, depending on the assigned slot.' },
      { t: 'Rehearse to time: 15 minutes is short for this much material.' },
