      { no: 20, date: 'Thu 19 Nov', topic: 'Final presentations (slot TBA)', projected: true },
    ],
    course: [
      { t: 'Assignment 4 released — final one of the four.' },
      { t: 'Build the 15-minute talk: the question, the agent setup, verification, the trade-off curve, where delegation stopped.' },
      { t: 'One-page note 24 h before the talk slot.' },
      { t: 'Peer reviews for everyone presenting in the same block.' },
    ],
    research: [
      { t: 'Consolidate results into final figures: compute budget vs docking reliability as the headline plot.' },
      { t: 'Write the results and discussion sections against the metrics defined back in week 3 — no new metrics now.' },
      { t: 'Have the agent argue against the conclusion, then check whether the objection survives the data.' },
      { t: 'Pull one clean example of an agent-generated result that was wrong and caught by the test suite. That belongs in the talk.' },
    ],
