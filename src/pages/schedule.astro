// ---------------------------------------------------------------------------
// Render the protected content to an HTML string, then encrypt it.
// ---------------------------------------------------------------------------
const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const statusBadge = (status: string) => {
  const map: Record<string, [string, string]> = {
    done: ['COMPLETE', 'text-space-400 border-space-400/30 bg-space-400/5'],
    current: ['CURRENT WEEK', 'text-thruster-300 border-thruster-400/40 bg-thruster-500/10'],
    upcoming: ['PLANNED', 'text-orbit border-orbit/30 bg-orbit/5'],
  };
  const [label, cls] = map[status] ?? map.upcoming;
  return `<span class="font-mono text-[10px] tracking-widest px-2 py-1 rounded border ${cls}">${label}</span>`;
};

const taskList = (items: { t: string; done?: boolean; due?: boolean }[]) => `
  <ul class="m-0 p-0 list-none space-y-2">
    ${items
      .map(
        (it) => `
      <li class="flex gap-3 text-sm leading-relaxed ${it.done ? 'text-space-500' : 'text-space-300'}">
        <span class="shrink-0 mt-[3px] font-mono text-xs ${
          it.done ? 'text-space-500' : it.due ? 'text-thruster-400' : 'text-orbit/60'
        }">${it.done ? '[x]' : '[ ]'}</span>
        <span class="${it.done ? 'line-through decoration-space-600' : ''}">${esc(it.t)}${
          it.due && !it.done
            ? ' <span class="font-mono text-[10px] tracking-widest text-thruster-400 align-middle">DUE</span>'
            : ''
        }</span>
      </li>`,
      )
      .join('')}
  </ul>`;

const deadlineRows = deadlines
  .map((d) => {
    const tone =
      d.status === 'done'
        ? 'text-space-500'
        : d.status === 'projected'
          ? 'text-space-300'
          : 'text-space-200';
    return `
      <tr class="border-b border-orbit/10 last:border-0">
        <td class="py-2 pr-4 font-mono text-xs text-orbit-light whitespace-nowrap align-top">${esc(d.date)}</td>
        <td class="py-2 text-sm ${tone}">${esc(d.what)}${
          d.status === 'done'
            ? ' <span class="font-mono text-[10px] tracking-widest text-space-500">DONE</span>'
            : ''
        }</td>
      </tr>`;
  })
  .join('');

const gradingRows = grading
  .map(
    (g) => `
      <tr class="border-b border-orbit/10 last:border-0">
        <td class="py-2 pr-4 text-sm text-space-300">${esc(g.c)}</td>
        <td class="py-2 font-mono text-xs text-thruster-300 whitespace-nowrap text-right">${esc(g.w)}</td>
      </tr>`,
  )
  .join('');

const weekCards = weeks
  .map(
    (w) => `
  <article id="week-${w.n}" class="rounded-xl border ${
    w.status === 'current' ? 'border-thruster-400/40' : 'border-orbit/15'
  } bg-space-900/30 overflow-hidden scroll-mt-28">
    <header class="flex flex-wrap items-center gap-3 px-5 py-4 border-b border-orbit/15 bg-space-950/40">
      <span class="font-mono text-xs tracking-widest text-orbit">WEEK ${String(w.n).padStart(2, '0')}</span>
      <span class="text-sm text-space-100 font-medium">${esc(w.range)}</span>
      <span class="font-mono text-[10px] tracking-widest text-space-400">${esc(w.block)}</span>
      <span class="ml-auto">${statusBadge(w.status)}</span>
    </header>

    <div class="px-5 py-4 border-b border-orbit/10 space-y-1">
      ${w.sessions
        .map(
          (s) => `
        <div class="flex flex-wrap gap-x-3 gap-y-1 text-sm ${s.off ? 'text-space-500' : 'text-space-300'}">
          <span class="font-mono text-xs ${s.off ? 'text-space-600' : 'text-orbit/70'} w-12 shrink-0">${
            s.no ? 'S' + String(s.no).padStart(2, '0') : '—'
          }</span>
          <span class="font-mono text-xs text-space-400 w-24 shrink-0">${esc(s.date)}</span>
          <span class="flex-1 min-w-[12rem]">${esc(s.topic)}</span>
        </div>`,
        )
        .join('')}
    </div>

    <div class="grid md:grid-cols-2 gap-0">
      <div class="p-5 border-b md:border-b-0 md:border-r border-orbit/15">
        <p class="font-mono text-xs text-orbit tracking-widest mb-3">COURSE TRACK</p>
        ${taskList(w.course)}
      </div>
      <div class="p-5 bg-thruster-500/[0.04]">
        <p class="font-mono text-xs text-thruster-400 tracking-widest mb-3">RESEARCH TRACK — ORLO* VISION</p>
        ${taskList(w.research)}
      </div>
    </div>
  </article>`,
  )
  .join('');

const protectedHtml = `
  <div class="space-y-10">
    <section>
      <h2 class="text-orbit-light">Fixed deadlines</h2>
      <p class="text-sm text-space-400 mt-2 mb-4">
        From the 16.S893 syllabus. Assignments 2–4 are released with their due dates as the term
        goes; the syllabus states the plan is one every three weeks from late September, so those
        three rows are projections to plan against, not announced dates.
      </p>
      <div class="rounded-xl border border-orbit/15 bg-space-900/30 px-5 py-3">
        <table class="w-full border-collapse"><tbody>${deadlineRows}</tbody></table>
      </div>
    </section>

    <section>
      <h2 class="text-orbit-light">Where the grade comes from</h2>
      <div class="mt-4 rounded-xl border border-orbit/15 bg-space-900/30 px-5 py-3">
        <table class="w-full border-collapse"><tbody>${gradingRows}</tbody></table>
      </div>
    </section>

    <section>
      <h2 class="text-orbit-light">Week by week</h2>
      <p class="text-sm text-space-400 mt-2 mb-2">
        Sessions meet Tuesday and Thursday, 9:30–11:00 am, room 33-218; twenty-three sessions total.
        Block A session dates and topics are published. Block B and C dates below follow the
        Tue/Thu pattern and are marked as projected, since the syllabus says exact dates and
        presentation slots are posted once the roster settles.
      </p>
      <p class="text-sm text-space-400 mb-6">
        The left column is coursework. The right column is the ORLO* research thread running in
        parallel — sized so each week is completable with an AI agent doing the drafting and
        sweeps, and with a verification step attached wherever the agent produces a number.
      </p>
      <div class="space-y-6">${weekCards}</div>
    </section>

    <section class="rounded-xl border border-orbit/15 bg-space-900/30 p-5">
      <p class="font-mono text-xs text-orbit tracking-widest mb-3">STANDING WEEKLY HABITS</p>
      <ul class="m-0 p-0 list-none space-y-2 text-sm text-space-300">
        <li class="flex gap-3"><span class="text-orbit/60 font-mono text-xs mt-[3px]">01</span><span>One dev-log entry per working session: what was built, what the agent got wrong, token and cost tally.</span></li>
        <li class="flex gap-3"><span class="text-orbit/60 font-mono text-xs mt-[3px]">02</span><span>Nothing agent-generated gets committed as a result until a test, a hand calculation, or an independent recompute agrees with it.</span></li>
        <li class="flex gap-3"><span class="text-orbit/60 font-mono text-xs mt-[3px]">03</span><span>Agent stays sandboxed: restricted working directory, no long-lived credentials in context.</span></li>
        <li class="flex gap-3"><span class="text-orbit/60 font-mono text-xs mt-[3px]">04</span><span>Write as many peer reviews as received, within 24 hours, one specific issue per GitHub issue.</span></li>
        <li class="flex gap-3"><span class="text-orbit/60 font-mono text-xs mt-[3px]">05</span><span>Every result carries its git SHA, config hash, and seed. Baselines are never overwritten.</span></li>
      </ul>
    </section>
  </div>`;

// AES-256-GCM, key derived with PBKDF2-SHA256. Salt and IV are fresh per build.
const salt = crypto.randomBytes(16);
const iv = crypto.randomBytes(12);
const key = crypto.pbkdf2Sync(PASSPHRASE, salt, PBKDF2_ITERATIONS, 32, 'sha256');
const cipher = crypto.createCipheriv('aes-256-gcm', key, iv);
const ciphertext = Buffer.concat([
  cipher.update(protectedHtml, 'utf8'),
  cipher.final(),
  cipher.getAuthTag(), // Web Crypto expects the tag appended to the ciphertext
]);

const payload = {
  salt: salt.toString('base64'),
  iv: iv.toString('base64'),
  data: ciphertext.toString('base64'),
  iterations: PBKDF2_ITERATIONS,
};
---

<BaseLayout
  title="Schedule"
  description="Week-by-week course and research schedule for MIT 16.S893 (password protected)"
>
  <section class="max-w-5xl mx-auto px-6 pt-12 pb-16">
    <p class="font-mono text-sm text-orbit tracking-widest mb-4" data-reveal="1">
      MIT 16.S893 · FALL 2026
    </p>
    <h1 data-reveal="1">Schedule</h1>
    <p class="mt-6 max-w-2xl text-base text-space-200" data-reveal="2">
      Week-by-week plan for the term: course sessions and assignments on one side, the ORLO*
      vision research thread running in parallel on the other.
    </p>

    <!-- Lock screen -->
    <div id="gate" class="mt-10 max-w-md" data-reveal="3">
      <div class="rounded-xl border border-orbit/20 bg-space-900/40 p-6">
        <div class="flex items-center gap-3 mb-4">
          <svg
            class="w-5 h-5 text-orbit"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <rect x="4" y="10" width="16" height="10" rx="2"></rect>
            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
          </svg>
          <p class="font-mono text-xs tracking-widest text-orbit m-0">PROTECTED</p>
        </div>

        <label for="pw" class="block text-sm text-space-300 mb-2">
          Enter the passphrase to view the schedule.
        </label>
        <form id="gate-form" class="flex gap-2" autocomplete="off">
          <input
            id="pw"
            type="password"
            name="passphrase"
            autocomplete="current-password"
            placeholder="Passphrase"
            class="flex-1 rounded-lg border border-orbit/25 bg-space-950/60 px-3 py-2 text-sm text-space-100 placeholder:text-space-500 outline-none focus:border-orbit/60"
          />
          <button
            type="submit"
            class="rounded-lg border border-orbit/40 bg-orbit/10 px-4 py-2 font-mono text-xs tracking-widest text-orbit-light hover:bg-orbit/20 transition-colors"
          >
            UNLOCK
          </button>
        </form>
        <p id="gate-error" class="mt-3 text-sm text-thruster-300 hidden m-0">
          Incorrect passphrase.
        </p>
        <p class="mt-4 text-xs text-space-500 m-0">
          Contents are AES-256-GCM encrypted in the page source and decrypted in the browser, so
          the schedule is not readable by viewing source.
        </p>
      </div>
    </div>

    <!-- Decrypted content lands here -->
    <div id="schedule-content" class="mt-10 hidden"></div>

    <div id="locked-actions" class="mt-6 hidden">
      <button
        id="relock"
        class="font-mono text-xs tracking-widest text-space-400 hover:text-orbit border-none bg-transparent cursor-pointer p-0"
      >
        ↺ LOCK AGAIN
      </button>
    </div>
  </section>

  <script type="application/json" id="schedule-payload" set:html={JSON.stringify(payload)} />

  <script>
    const payloadEl = document.getElementById('schedule-payload');
    const gate = document.getElementById('gate');
    const form = document.getElementById('gate-form');
    const input = document.getElementById('pw') as HTMLInputElement | null;
    const errorEl = document.getElementById('gate-error');
    const content = document.getElementById('schedule-content');
    const lockedActions = document.getElementById('locked-actions');
    const relock = document.getElementById('relock');
    const STORAGE_KEY = 'mk-schedule-pw';

    if (payloadEl && gate && form && input && errorEl && content && lockedActions) {
      const payload = JSON.parse(payloadEl.textContent || '{}');

      const b64 = (s: string) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));

      async function decrypt(passphrase: string): Promise<string | null> {
        try {
          const enc = new TextEncoder();
          const baseKey = await crypto.subtle.importKey(
            'raw',
            enc.encode(passphrase),
            'PBKDF2',
            false,
            ['deriveKey'],
          );
          const key = await crypto.subtle.deriveKey(
            {
              name: 'PBKDF2',
              salt: b64(payload.salt),
              iterations: payload.iterations,
              hash: 'SHA-256',
            },
            baseKey,
            { name: 'AES-GCM', length: 256 },
            false,
            ['decrypt'],
          );
          const plain = await crypto.subtle.decrypt(
            { name: 'AES-GCM', iv: b64(payload.iv) },
            key,
            b64(payload.data),
          );
          return new TextDecoder().decode(plain);
        } catch {
          return null; // wrong passphrase → auth tag check fails
        }
      }

      function unlock(html: string) {
        content.innerHTML = html;
        content.classList.remove('hidden');
        lockedActions.classList.remove('hidden');
        gate.classList.add('hidden');
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.classList.add('hidden');
        const pass = input.value;
        if (!pass) return;
        const html = await decrypt(pass);
        if (html) {
          try {
            sessionStorage.setItem(STORAGE_KEY, pass);
          } catch {}
          unlock(html);
        } else {
          errorEl.classList.remove('hidden');
          input.select();
        }
      });

      relock?.addEventListener('click', () => {
        try {
          sessionStorage.removeItem(STORAGE_KEY);
        } catch {}
        content.innerHTML = '';
        content.classList.add('hidden');
        lockedActions.classList.add('hidden');
        gate.classList.remove('hidden');
        input.value = '';
      });

      // Stay unlocked while the tab is open.
      (async () => {
        let saved: string | null = null;
        try {
          saved = sessionStorage.getItem(STORAGE_KEY);
        } catch {}
        if (saved) {
          const html = await decrypt(saved);
          if (html) unlock(html);
        }
      })();
    }
  </script>
</BaseLayout>

<style is:global>
  #schedule-content h2 {
    font-size: 1.35rem;
    margin: 0;
  }
  #schedule-content table {
    margin: 0;
  }
</style>
