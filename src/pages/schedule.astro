      { t: 'Assignment 2 expected to be released this week — read it the day it lands and scope it against the research plan.' },
      { t: 'Stand up a test suite + CI on the research repo so agent output has an accept/reject signal.' },
      { t: 'Write AGENTS.md: repo conventions, what the agent may touch, how to run the tests.' },
      { t: 'Externalize memory — a running notes file the agent reads at session start instead of re-deriving context.' },
      { t: 'Dev log: one instance of context rot, what it produced, and how it was caught.' },
    ],
    research: [
      { t: 'Stand up the simulation: R1, R2, and 1 m² panel geometry with a mounted camera on R2.' },
      { t: 'Camera model with real intrinsics and image noise; deterministic seeds so any run is reproducible.' },
      { t: 'Ground-truth pose logging at every frame — this is the whole basis of every later number.' },
      { t: 'Hand-verify the agent\'s transform math: check one R2→R1 relative pose against a pencil-and-paper calculation before trusting the suite.' },
      { t: 'Unit tests on geometry: round-trip pose composition, reprojection of a known point, units and frame conventions.' },
      { t: 'Render 20 frames and eyeball them. Wrong-but-plausible renders are the most expensive failure here.' },
    ],
  },
  {
    n: 5,
    range: 'Mon 5 – Sun 11 Oct',
    block: 'Block A → B',
    status: 'upcoming',
    sessions: [
      { no: 8, date: 'Tue 6 Oct', topic: 'Subagents and orchestration' },
      { no: 9, date: 'Thu 8 Oct', topic: 'Pod clinic, round 1 — presenter' },
    ],
