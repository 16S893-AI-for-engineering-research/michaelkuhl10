      { t: 'Buffer week — re-run anything that was flaky and settle it.' },
      { t: 'Release artefacts: frozen model weights, dataset generation seeds, one-command repro script.' },
      { t: 'Write limitations honestly: sim-only, monocular, R2→R1 docking only, no R1 row-advance, no hardware.' },
      { t: 'Future work memo: the path from this result to the actual controls thesis, including a hardware demonstration.' },
    ],
  },
  {
    n: 13,
    range: 'Mon 30 Nov – Sun 6 Dec',
    block: 'Block C ends',
    status: 'upcoming',
    sessions: [
      { no: 22, date: 'Tue 1 Dec', topic: 'Final presentations (slot TBA)', projected: true },
      { no: 23, date: 'Thu 3 Dec', topic: 'Final presentations — last session (slot TBA)', projected: true },
    ],
