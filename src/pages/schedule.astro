    ],
  },
  {
    n: 6,
    range: 'Mon 12 – Sun 18 Oct',
    block: 'Block B',
    status: 'upcoming',
    sessions: [
      { no: null, date: 'Tue 13 Oct', topic: 'No class — MIT runs a Monday schedule', off: true },
      { no: 10, date: 'Thu 15 Oct', topic: 'Pod clinic, round 1 (roles reverse) — reviewer' },
    ],
    course: [
      { t: 'Reviewer role Thu 15 Oct: inspect the assigned repo and file issues with concrete evidence.' },
      { t: 'Act on the issues filed against this repo last week; close each one with a commit or a written reason.' },
      { t: 'Assignment 2 work — keep it inside the research repo rather than as a side exercise.' },
      { t: 'Dev log: token/cost tracking for the week.' },
