      { t: 'Draft the controls-thesis framing and get the scope question in front of the advisor.', done: true },
      { t: 'Narrow from "a controls thesis" to something a semester can hold: perception for docking.', done: true },
      { t: 'Debug and document the pi / MIT Parley tool-loss failure (Sept 21 Tragedy) — a real agent failure mode for the portfolio.', done: true },
    ],
  },
  {
    n: 3,
    range: 'Mon 21 – Sun 27 Sep',
    block: 'Block A',
    status: 'current',
    sessions: [
      { no: 4, date: 'Tue 22 Sep', topic: 'Sandboxing agents: threats, the lethal trifecta, isolation' },
      { no: 5, date: 'Thu 24 Sep', topic: 'Lightning talks on project proposals — 3 minutes each' },
    ],
    course: [
      { t: 'Project one-pager + advisor sign-off by reply-all email — due Tue 22 Sep.', due: true },
