  },
  {
    n: 4,
    range: 'Mon 28 Sep – Sun 4 Oct',
    block: 'Block A',
    status: 'upcoming',
    sessions: [
      { no: 6, date: 'Tue 29 Sep', topic: 'Software-engineering practices: testing and verification' },
      { no: 7, date: 'Thu 1 Oct', topic: 'Task decomposition, workflows, externalized memory and context rot' },
