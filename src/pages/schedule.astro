    range: 'Mon 19 – Sun 25 Oct',
    block: 'Block B',
    status: 'upcoming',
    sessions: [
      { no: 11, date: 'Tue 20 Oct', topic: 'Project work / topic session (date projected)', projected: true },
      { no: 12, date: 'Thu 22 Oct', topic: 'Project work / topic session (date projected)', projected: true },
    ],
    course: [
      { t: 'Assignment 2 due ~Tue 20 Oct (projected — confirm the real date in class).', due: true },
      { t: 'Publish the assignment by pushing it to the repo; make sure another student could re-run it.' },
      { t: 'Show unfinished work in session — the failing training run is more useful to the class than a clean plot.' },
