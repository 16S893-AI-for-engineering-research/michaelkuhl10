---
import BaseLayout from '@layouts/BaseLayout.astro';
import { resolvePath } from '../lib/paths';
---

<BaseLayout title="About">
  <section class="max-w-4xl mx-auto px-6 pt-12 pb-16">
    <h1 data-reveal="1">About</h1>

    <div class="mt-8 mb-12" data-reveal="2">
      <p class="text-base text-space-200 leading-relaxed max-w-2xl">
        I'm <strong>Michael Kuhl</strong>, a graduate student in the MIT Department of
        Aeronautics and Astronautics, working in the <strong>Space Telecommunications,
        Astronomy and Radiation Laboratory (STAR Lab)</strong> under <strong>Prof. Kerri
        Cahoy</strong>. For this course, I'm developing and evaluating a lightweight
        computer vision model for autonomous in-space robotic assembly — see the{' '}
        <a href={resolvePath('/project')}>project page</a> for the full proposal. For more
        on the lab's broader research,
        visit the <a href="https://starlab.mit.edu">STAR Lab website</a>.
      </p>
    </div>

    <h2 data-reveal="3">Beyond research</h2>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8" data-reveal="3">
      <div class="border border-orbit/15 rounded-xl p-3">
        <div class="aspect-square overflow-hidden rounded-lg mb-2">
          <img
            src={resolvePath('/images/Grad.jpeg')}
            alt="Michael Kuhl, Harvard graduation"
            class="w-full h-full object-cover"
          />
        </div>
        <p class="text-xs text-space-400 m-0">Harvard, 2026</p>
      </div>
      <div class="border border-orbit/15 rounded-xl p-3">
        <div class="aspect-square overflow-hidden rounded-lg mb-2">
          <img
            src={resolvePath('/images/Hockey.jpeg')}
            alt="Hockey"
            class="w-full h-full object-cover"
          />
        </div>
        <p class="text-xs text-space-400 m-0">Club hockey</p>
      </div>
      <div class="border border-orbit/15 rounded-xl p-3">
        <div class="aspect-square overflow-hidden rounded-lg mb-2">
          <img
            src={resolvePath('/images/Surf.jpeg')}
            alt="Surfing"
            class="w-full h-full object-cover object-center"
          />
        </div>
        <p class="text-xs text-space-400 m-0">Surfing</p>
      </div>
      <div class="border border-orbit/15 rounded-xl p-3">
        <div class="aspect-square overflow-hidden rounded-lg mb-2">
          <img
            src={resolvePath('/images/Fish.jpeg')}
            alt="Fishing"
            class="w-full h-full object-cover"
          />
        </div>
        <p class="text-xs text-space-400 m-0">Fishing</p>
      </div>
      <div class="border border-orbit/15 rounded-xl p-3">
        <div class="aspect-square overflow-hidden rounded-lg mb-2">
          <img
            src={resolvePath('/images/Travel.jpeg')}
            alt="Travel"
            class="w-full h-full object-cover"
          />
        </div>
        <p class="text-xs text-space-400 m-0">Travel</p>
      </div>
    </div>

    <h2 data-reveal="4">Contact & links</h2>
    <div class="space-y-2 text-base text-space-300" data-reveal="4">
      <p>
        <strong>GitHub:</strong>{' '}
        <a href="https://github.com/michaelkuhl10">@michaelkuhl10</a>
      </p>
      <p>
        <strong>MIT STAR Lab:</strong>{' '}
        <a href="https://starlab.mit.edu">starlab.mit.edu</a>
      </p>
    </div>
  </section>
</BaseLayout>
