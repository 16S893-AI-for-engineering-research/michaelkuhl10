---
interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="my-6">
  <img
    {src}
    {alt}
    class="w-full h-auto border border-orbit/15"
  />
  {caption && <figcaption class="text-xs text-space-400 italic mt-2">{caption}</figcaption>}
</figure>
