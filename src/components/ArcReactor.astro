---
// Header logo with the Tony Stark easter egg: hover (or keyboard focus) to
// reveal the "Made by J.A.R.V.I.S." hologram.
---

<span class="arc-wrap" tabindex="0" aria-describedby="jarvis-tip">
  <svg viewBox="0 0 40 40" class="arc-svg" aria-hidden="true">
    <circle cx="20" cy="20" r="17" fill="none" stroke="#0ba9dc" stroke-width="2.5" />
    <g class="arc-pylons">
      {Array.from({ length: 8 }).map((_, i) => (
        <rect x="19" y="5.5" width="2" height="5" rx="0.6" fill="#33c7f2" transform={`rotate(${i * 45} 20 20)`} />
      ))}
    </g>
    <circle cx="20" cy="20" r="7" fill="#33c7f2" class="arc-core" />
    <circle cx="20" cy="20" r="3" fill="#eafcff" />
  </svg>
  <span class="hologram" role="tooltip" id="jarvis-tip">
    <span class="hologram-inner">Made by J.A.R.V.I.S.</span>
  </span>
</span>

<style>
  .arc-wrap {
    position: relative;
    display: inline-flex;
    width: 28px;
    height: 28px;
    cursor: pointer;
    outline: none;
  }
  .arc-svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 4px rgba(51, 199, 242, 0.55));
    transition: filter 0.25s ease;
  }
  .arc-wrap:hover .arc-svg,
  .arc-wrap:focus-visible .arc-svg {
    filter: drop-shadow(0 0 9px rgba(51, 199, 242, 0.95));
  }
  .arc-pylons {
    transform-origin: 20px 20px;
    animation: arcSpin 10s linear infinite;
  }
  .arc-wrap:hover .arc-pylons { animation-duration: 2.5s; }
  .arc-core {
    transform-origin: 20px 20px;
    animation: arcPulse 2.2s ease-in-out infinite;
  }

  .hologram {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-20%) translateY(-6px);
    opacity: 0;
    pointer-events: none;
    white-space: nowrap;
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 60;
  }
  .arc-wrap:hover .hologram,
  .arc-wrap:focus-visible .hologram {
    opacity: 1;
    transform: translateX(-20%) translateY(0);
  }
  .hologram-inner {
    position: relative;
    display: block;
    padding: 0.55rem 1rem;
    border-radius: 4px;
    background: rgba(8, 28, 42, 0.88);
    border: 1px solid rgba(116, 220, 251, 0.75);
    box-shadow: 0 0 18px rgba(51, 199, 242, 0.5), inset 0 0 12px rgba(51, 199, 242, 0.18);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: #eafcff;
    text-shadow: 0 0 8px rgba(116, 220, 251, 0.95);
    animation: holoFlicker 2.5s steps(30) infinite;
  }
  /* connector line up to the reactor */
  .hologram-inner::before {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 20%;
    width: 1px;
    height: 12px;
    background: rgba(116, 220, 251, 0.75);
  }
  /* scan lines */
  .hologram-inner::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 4px;
    background: repeating-linear-gradient(0deg, rgba(116, 220, 251, 0.07) 0 1px, transparent 1px 3px);
    pointer-events: none;
  }

  @keyframes arcSpin { to { transform: rotate(360deg); } }
  @keyframes arcPulse {
    0%, 100% { opacity: 0.75; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.1); }
  }
  @keyframes holoFlicker {
    0%, 100% { opacity: 1; }
    8% { opacity: 0.85; }
    9% { opacity: 1; }
    22% { opacity: 0.7; }
    23% { opacity: 1; }
    60% { opacity: 0.9; }
    61% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .arc-pylons, .arc-core, .hologram-inner { animation: none; }
  }
</style>
